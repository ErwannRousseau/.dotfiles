{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "context-mode",
    "oh-my-openagent@latest"
  ],
  "mcp": {
    "figma-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com",
      "enabled": false
    },
    "context-mode": {
      "type": "local",
      "command": [
        "context-mode"
      ]
    },
    "semble": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "semble[mcp]",
        "semble"
      ]
    }
  },
  "tools": {
    "argent*": true
  }
}
