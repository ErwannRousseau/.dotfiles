{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "context-mode"
  ],
  "mcp": {
    "figma-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": false
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com",
      "enabled": false
    },
    "context-mode": {
      "type": "local",
      "command": [
        "context-mode"
      ]
    },
    "semble": {"command": ["uvx", "--from", "semble[mcp]==0.5.5", "semble"], "type": "local", "enabled": true},
    "exa-websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "enabled": true
    },
    "context7-docs": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "github-grep": {
      "type": "remote",
      "url": "https://mcp.grep.app/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "tools": {
    "lsp": true
  }
}
