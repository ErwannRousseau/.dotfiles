#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")" && pwd)"
status=0

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  blue=$'\033[34m'
  green=$'\033[32m'
  red=$'\033[31m'
  reset=$'\033[0m'
else
  blue= green= red= reset=
fi

label() { printf '%s%s:%s ' "$blue" "$1" "$reset"; }
ok() { printf '%sok%s\n' "$green" "$reset"; }
bad() { printf '%s%s%s\n' "$red" "$1" "$reset"; }

verify_stow_links() {
  local source_dir=$1
  local target_dir=$2
  local excluded_dir=${3:-}
  local source_file relative_path target_file

  while IFS= read -r source_file; do
    if [[ -n $excluded_dir && $source_file == "$source_dir/$excluded_dir/"* ]]; then
      continue
    fi
    relative_path=${source_file#"$source_dir/"}
    target_file="$target_dir/$relative_path"
    if [[ ! -L $target_file ]]; then
      printf 'missing link: %s\n' "$target_file" >&2
      return 1
    fi
  done < <(find "$source_dir" -type f ! -name .gitignore ! -name .stow-local-ignore)
}

label 'Homebrew bundle'
if brew bundle check --file="$repo_dir/Brewfile"; then
  ok
else
  bad 'missing'
  status=1
fi

if [[ -f "$repo_dir/Brewfile.local" ]]; then
  label 'Local Homebrew bundle'
  if brew bundle check --file="$repo_dir/Brewfile.local"; then
    ok
  else
    bad 'missing'
    status=1
  fi
fi

label 'Stow links'
if stow --dir "$repo_dir/packages" --target "$HOME" --no-folding --simulate --restow shell git editor terminal &&
  stow --dir "$repo_dir/packages" --target "$HOME" --simulate --restow agents &&
  stow --dir "$repo_dir/packages/editor" --target "$HOME/Library/Application Support/Code/User" --no-folding --simulate --restow vscode &&
  verify_stow_links "$repo_dir/packages/shell" "$HOME" &&
  verify_stow_links "$repo_dir/packages/git" "$HOME" &&
  verify_stow_links "$repo_dir/packages/editor" "$HOME" vscode &&
  verify_stow_links "$repo_dir/packages/terminal" "$HOME" &&
  verify_stow_links "$repo_dir/packages/agents" "$HOME" .agents &&
  verify_stow_links "$repo_dir/packages/editor/vscode" "$HOME/Library/Application Support/Code/User"; then
  ok
else
  bad 'broken'
  status=1
fi

label 'Agent skills'
if [[ -d "$HOME/.agents/skills" && ! -L "$HOME/.agents/skills" ]]; then
  ok
else
  bad 'missing'
  status=1
fi

label 'Skills lock'
if [[ -L "$HOME/.agents/skills-lock.json" && "$HOME/.agents/skills-lock.json" -ef "$repo_dir/skills-lock.json" ]]; then
  ok
else
  bad 'missing'
  status=1
fi

label 'macOS defaults'
if "$repo_dir/macos" --check; then
  ok
else
  bad 'drifted'
  status=1
fi

(( status == 0 )) && printf '%s✓ All checks passed%s\n' "$green" "$reset"
exit "$status"
