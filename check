#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")" && pwd)"
repo_skills_lock="$repo_dir/packages/agents/.agents/skills-lock.json"
host_skills_lock="$HOME/.agents/.skill-lock.json"
host_compat_skills_lock="$HOME/.agents/skills-lock.json"
ohmyzsh_commit='4b657407c98bbc8830ae66c2ac7ff3d737c55a83'
nvm_release='0.40.7'
node_release='v24.15.0'
status=0

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  blue=$'\033[34m'
  green=$'\033[32m'
  red=$'\033[31m'
  reset=$'\033[0m'
else
  blue='' green='' red='' reset=''
fi

label() { printf '%s%s:%s ' "$blue" "$1" "$reset"; }
ok() { printf '%sok%s\n' "$green" "$reset"; }
bad() { printf '%s%s%s\n' "$red" "$1" "$reset"; }

verify_stow_links() {
  local source_dir=$1
  local target_dir=$2
  local excluded_dir=${3:-}
  local source_file relative_path target_file

  while IFS= read -r source_file; do
    if [[ -n $excluded_dir && $source_file == "$source_dir/$excluded_dir/"* ]]; then
      continue
    fi
    relative_path=${source_file#"$source_dir/"}
    target_file="$target_dir/$relative_path"
    if [[ ! -L $target_file || ! $target_file -ef $source_file ]]; then
      printf 'missing link: %s\n' "$target_file" >&2
      return 1
    fi
  done < <(find "$source_dir" -type f ! -name .git ! -path '*/.git/*' ! -name .gitignore ! -name .stow-local-ignore ! -name .cvsignore)
}

label 'Homebrew bundle'
if HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_BUNDLE_NO_UPGRADE=1 brew bundle check --file="$repo_dir/Brewfile"; then
  ok
else
  bad 'missing'
  status=1
fi

if [[ -f "$repo_dir/Brewfile.local" ]]; then
  label 'Local Homebrew bundle'
  if HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_BUNDLE_NO_UPGRADE=1 brew bundle check --file="$repo_dir/Brewfile.local"; then
    ok
  else
    bad 'missing'
    status=1
  fi
fi

label 'Oh My Zsh'
if [[ -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" && -d "$HOME/.oh-my-zsh/.git" &&
  "$(git -C "$HOME/.oh-my-zsh" rev-parse HEAD)" == "$ohmyzsh_commit" ]]; then
  ok
else
  bad 'missing or wrong revision'
  status=1
fi

label 'NVM and Node'
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck source=/dev/null
  . "$NVM_DIR/nvm.sh"
fi
if command -v nvm >/dev/null 2>&1 && [[ "$(nvm --version)" == "$nvm_release" ]] &&
  nvm use --silent default >/dev/null && [[ "$(node --version)" == "$node_release" ]]; then
  ok
else
  bad 'missing or wrong version'
  status=1
fi

label 'Developer tools'
missing_tools=()
for tool in bun pnpm yarn semble graft agent-device rtk; do
  command -v "$tool" >/dev/null 2>&1 || missing_tools+=("$tool")
done
if (( ${#missing_tools[@]} == 0 )); then
  ok
else
  bad "missing: ${missing_tools[*]}"
  status=1
fi

label 'Shell plugin submodules'
submodule_status="$(git -C "$repo_dir" submodule status --recursive)"
if [[ -n "$submodule_status" ]] && ! grep -qE '^[-+U]' <<<"$submodule_status"; then
  ok
else
  bad 'missing or out of sync'
  status=1
fi

label 'Stow links'
if "$repo_dir/link" --check &&
  verify_stow_links "$repo_dir/packages/shell" "$HOME" &&
  verify_stow_links "$repo_dir/packages/git" "$HOME" &&
  verify_stow_links "$repo_dir/packages/editor" "$HOME" vscode &&
  verify_stow_links "$repo_dir/packages/terminal" "$HOME" &&
  verify_stow_links "$repo_dir/packages/agents" "$HOME" .agents &&
  verify_stow_links "$repo_dir/packages/editor/vscode" "$HOME/Library/Application Support/Code/User"; then
  ok
else
  bad 'broken'
  status=1
fi

label 'Agent skills'
if [[ -d "$HOME/.agents/skills" && ! -L "$HOME/.agents/skills" ]]; then
  ok
else
  bad 'missing'
  status=1
fi

label 'Skills lock'
if [[ -f "$repo_skills_lock" && ! -L "$repo_skills_lock" &&
  -L "$host_skills_lock" && "$host_skills_lock" -ef "$repo_skills_lock" &&
  -L "$host_compat_skills_lock" && "$host_compat_skills_lock" -ef "$repo_skills_lock" ]]; then
  ok
else
  bad 'missing or out of sync'
  status=1
fi

label 'macOS defaults'
if "$repo_dir/macos" --check; then
  ok
else
  bad 'drifted'
  status=1
fi

(( status == 0 )) && printf '%s✓ All checks passed%s\n' "$green" "$reset"
exit "$status"
