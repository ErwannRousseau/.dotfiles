#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")" && pwd)"

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  blue=$'\033[34m'
  green=$'\033[32m'
  red=$'\033[31m'
  reset=$'\033[0m'
else
  blue= green= red= reset=
fi

case "${1:-}" in
  "")
    stow_options=(--restow)
    ;;
  --adopt)
    stow_options=(--adopt --restow)
    printf '%s==> Adopting existing files%s\n' "$blue" "$reset"
    ;;
  *)
    printf '%sUsage: %s [--adopt]%s\n' "$red" "$0" "$reset" >&2
    exit 2
    ;;
esac

for target in \
  "$HOME/Library/Application Support/Code/User/settings.json" \
  "$HOME/Library/Application Support/Code/User/keybindings.json" \
  "$HOME/Library/Application Support/Code/User/snippets/fetch.code-snippets" \
  "$HOME/Library/Application Support/Code/User/snippets/javascript.json" \
  "$HOME/Library/Application Support/Code/User/snippets/typescriptreact.code-snippets"; do
  [[ -L "$target" && ( "$(readlink "$target")" == *"/packages/vscode/"* || "$(readlink "$target")" == *"/packages/editor/vscode/Library/"* ) ]] && rm "$target"
done

printf '%s==> Linking dotfiles%s\n' "$blue" "$reset"
stow --dir "$repo_dir/packages" --target "$HOME" --no-folding "${stow_options[@]}" shell git editor terminal
stow --dir "$repo_dir/packages/editor" --target "$HOME/Library/Application Support/Code/User" --no-folding "${stow_options[@]}" vscode
printf '%s✓ Dotfiles linked%s\n' "$green" "$reset"
