#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")" && pwd)"

case "${1:-}" in
  "")
    stow_options=(--restow)
    ;;
  --adopt)
    stow_options=(--adopt --restow)
    ;;
  *)
    printf 'Usage: %s [--adopt]\n' "$0" >&2
    exit 2
    ;;
esac

stow --dir "$repo_dir/packages" --target "$HOME" --no-folding "${stow_options[@]}" shell git editor terminal
